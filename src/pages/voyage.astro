---
import Base from '../layouts/Base.astro';
import { ITINERAIRE } from '../data/itineraire';
import { TRANSPORTS } from '../data/schema';
import { dateEnFrancais, situationAu } from '../lib/voyage';
import { lien } from '../lib/lien';

const situation = situationAu();
---

<Base
  titre="Le voyage jour par jour — Thaïlande et Laos"
  description="Les 25 journées du voyage de Robin, racontées simplement, du départ de Genève au retour."
  pageActive="voyage"
>
  <section class="mt-6">
    <h2 class="text-2xl sm:text-3xl font-bold">Le voyage, jour par jour</h2>
    <p class="mt-3 text-lg">
      Du 5 au 30 octobre 2026, de Bangkok à Chiang Mai en passant par le Laos. Touchez une journée
      pour la déplier et lire ce qui est prévu.
    </p>

    <ol id="frise" class="mt-7 space-y-3">
      {
        ITINERAIRE.map((jour, index) => (
          <li
            data-index={index}
            data-etat={
              situation.etat === 'pendant' && index === situation.index
                ? 'aujourdhui'
                : situation.etat === 'apres' || (situation.etat === 'pendant' && index < situation.index)
                  ? 'passe'
                  : 'avenir'
            }
            class="carte-blanche border-l-4 border-l-bordure data-[etat=passe]:border-l-or data-[etat=aujourdhui]:border-l-alerte"
          >
            <details name="frise-voyage">
              <summary class="list-none p-4 sm:p-5">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="text-sm font-semibold uppercase tracking-wide text-encre-douce">
                      Jour {index + 1} · {dateEnFrancais(jour.dateISO)}
                    </p>
                    <p class="mt-1 text-xl font-bold">
                      <span aria-hidden="true">{jour.drapeau}</span> {jour.ville}
                    </p>
                    <p class="mt-1 text-encre-douce">{jour.titreSimple}</p>
                  </div>
                  <span aria-hidden="true" class="text-2xl shrink-0">
                    {TRANSPORTS[jour.transport].emoji}
                  </span>
                </div>
                <p
                  data-badge="aujourdhui"
                  hidden
                  class="mt-3 inline-block rounded-full bg-alerte-pale px-3 py-1 text-sm font-bold text-alerte"
                >
                  Robin y est aujourd’hui
                </p>
              </summary>

              <div class="px-4 pb-5 sm:px-5">
                <img
                  src={jour.photo}
                  alt=""
                  width="1000"
                  height="563"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  class="w-full aspect-[16/9] object-cover rounded-xl"
                />
                <p class="mt-4 text-lg leading-relaxed">{jour.resumeFamille}</p>

                <dl class="mt-4 space-y-2 text-base">
                  <div class="flex gap-2">
                    <dt class="font-semibold shrink-0">Le moment fort :</dt>
                    <dd>{jour.tempsFort}</dd>
                  </div>
                  <div class="flex gap-2">
                    <dt class="font-semibold shrink-0">Il dort :</dt>
                    <dd>{jour.dortA}</dd>
                  </div>
                  <div class="flex gap-2">
                    <dt class="font-semibold shrink-0">Déplacement :</dt>
                    <dd>{TRANSPORTS[jour.transport].label}</dd>
                  </div>
                </dl>
              </div>
            </details>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-8">
    <a href={lien('/')} class="bouton bouton-secondaire w-full">Revenir à « En ce moment »</a>
  </section>
</Base>

<script>
  import { situationAu } from '../lib/voyage';

  const situation = situationAu();
  const elements = document.querySelectorAll<HTMLLIElement>('#frise > li');

  elements.forEach((element, index) => {
    const etat =
      situation.etat === 'pendant' && index === situation.index
        ? 'aujourdhui'
        : situation.etat === 'apres' || (situation.etat === 'pendant' && index < situation.index)
          ? 'passe'
          : 'avenir';

    element.dataset.etat = etat;

    const badge = element.querySelector<HTMLElement>('[data-badge="aujourdhui"]');
    if (badge) badge.hidden = etat !== 'aujourdhui';

    if (etat === 'aujourdhui') {
      element.querySelector('details')?.setAttribute('open', '');
    }
  });
</script>
